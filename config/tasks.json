          "status": "Pending",
          "tootip": "Comprova que scripting.%GRUP%.local resol",
          "extrafield": "None",
          "command": "dig scripting.%GRUP%.local @127.0.0.1 +noall +answer | grep -Eq '\\sCNAME\\s|\\sA\\s|\\sAAAA\\s' || nslookup scripting.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "CNAME bck creat",
          "status": "Pending",
          "tootip": "Comprova que bck.%GRUP%.local resol (habitualment CNAME cap a backups)",
          "extrafield": "None",
          "command": "dig bck.%GRUP%.local @127.0.0.1 +noall +answer | grep -Eq '\\sCNAME\\s|\\sA\\s|\\sAAAA\\s' || nslookup bck.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "Resolució local via resolv.conf",
          "status": "Pending",
          "tootip": "Comprova que el sistema pot resoldre usant el DNS configurat",
          "extrafield": "None",
          "command": "getent hosts server.%GRUP%.local >/dev/null 2>&1"
        },{
          "tarea": "Resposta autoritativa per la zona",
          "status": "Pending",
          "tootip": "Comprova que el servidor respon com a autoritatiu (AA) per %GRUP%.local",
          "extrafield": "None",
          "command": "dig %GRUP%.local SOA @127.0.0.1 +noall +flags | grep -q ' aa '"
        },{
          "tarea": "Transferència de zona bloquejada (AXFR)",
          "status": "Pending",
          "tootip": "Comprova que una AXFR no està permesa (bones pràctiques)",
          "extrafield": "None",
          "command": "dig AXFR %GRUP%.local @127.0.0.1 +time=2 +tries=1 | grep -Eq 'Transfer failed|failed|REFUSED|not authorized'"
        },{
          "tarea": "Sense recursivitat per clients externs (si s'exigeix)",
          "status": "Pending",
          "tootip": "Comprova que recursion està desactivat o restringit (segons política)",
          "extrafield": "None",
          "command": "dig @127.0.0.1 google.com A +time=2 +tries=1 +noall +comments | grep -Eq 'recursion (not available|requested but not available)' || true"
        },{
          "tarea": "Reenviadors configurats",
          "status": "Pending",
          "tootip": "Comprova que hi ha forwarders definits a la configuració (named.conf.options o equivalent)",
          "extrafield": "None",
          "command": "grep -Riq \"forwarders\\s*{[^}]*;\" /etc/bind /etc/named* 2>/dev/null"
        },{
          "tarea": "Reenviador funcional: resol smx2-projecte.es",
          "status": "Pending",
          "tootip": "Comprova que es poden resoldre dominis externs via reenviador",
          "extrafield": "None",
          "command": "dig +short smx2-projecte.es A @127.0.0.1 | grep -Eq '([0-9]{1,3}\\.){3}[0-9]{1,3}' || nslookup smx2-projecte.es 127.0.0.1"
        },{
          "tarea": "Reenviador funcional: resol smx2.local",
          "status": "Pending",
          "tootip": "Comprova que el DNS pot resoldre smx2.local (segons el vostre entorn)",
          "extrafield": "None",
          "command": "dig +short smx2.local @127.0.0.1 | grep -q '.' || nslookup smx2.local 127.0.0.1"
        },{
          "tarea": "Fitxer de zona existent (si es pot localitzar)",
          "status": "Pending",
          "tootip": "Comprova que hi ha un fitxer de zona referenciat per %GRUP%.local a named.conf.local",
          "extrafield": "None",
          "command": "grep -R \"zone \\\"%GRUP%\\.local\\\"\" -n /etc/bind 2>/dev/null | grep -q ."
        },{
          "tarea": "Validació del fitxer de zona (si es pot inferir la ruta)",
          "status": "Pending",
          "tootip": "Intenta executar named-checkzone amb el fitxer indicat a la configuració",
          "extrafield": "None",
          "command": "ZFILE=$(grep -R \"zone \\\"%GRUP%\\.local\\\"\" -n /etc/bind 2>/dev/null | head -n1 | awk -F: '{print $1}' | xargs -r sed -n '/zone \"%GRUP%\\.local\"/,/};/p' | grep -E 'file\\s+\"' | head -n1 | sed -E 's/.*file\\s+\"([^\"]+)\".*/\\1/'); if [ -n \"$ZFILE\" ] && [ -f \"$ZFILE\" ]; then named-checkzone %GRUP%.local \"$ZFILE\"; else true; fi"
        },{
          "tarea": "TTL i SOA presents",
          "status": "Pending",
          "tootip": "Comprova que la zona té SOA i que respon amb dades completes",
          "extrafield": "None",
          "command": "dig %GRUP%.local SOA @127.0.0.1 +noall +answer | grep -Eq '\\sSOA\\s'"
        }
      ]
    },
