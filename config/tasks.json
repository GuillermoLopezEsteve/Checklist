{
    "zones":  [
            {
              "title": "Accés remot als servidors",
              "id": "REMOTE-ACCESS",
              "tasks": [
                {
                  "tarea": "Servidor SSH instal·lat",
                  "status": "Pending",
                  "tootip": "Comprova que OpenSSH Server està instal·lat (sshd disponible)",
                  "extrafield": "None",
                  "command": "command -v sshd >/dev/null 2>&1 || dpkg -l | grep -Eq '^ii\\s+openssh-server\\s' || rpm -qa | grep -qi openssh-server"
                },{
                  "tarea": "Servidor SSH actiu",
                  "status": "Pending",
                  "tootip": "Comprova que el servei ssh/sshd està en execució",
                  "extrafield": "None",
                  "command": "systemctl is-active ssh >/dev/null 2>&1 || systemctl is-active sshd"
                },{
                  "tarea": "Servidor SSH escoltant al port 2222",
                  "status": "Pending",
                  "tootip": "Comprova que hi ha un socket escoltant al port TCP 2222",
                  "extrafield": "None",
                  "command": "ss -ltn | awk '{print $4}' | grep -Eq '(:|\\.)2222$'"
                },{
                  "tarea": "Usuari guille existeix",
                  "status": "Pending",
                  "tootip": "Comprova que l'usuari guille existeix al sistema",
                  "extrafield": "None",
                  "command": "id guille >/dev/null 2>&1"
                },{
                  "tarea": "Usuari guille forma part del grup admins",
                  "status": "Pending",
                  "tootip": "Comprova que guille pertany al grup admins",
                  "extrafield": "None",
                  "command": "id -nG guille | tr ' ' '\\n' | grep -qx admins"
                },{
                  "tarea": "Usuari guille té accés SSH",
                  "status": "Pending",
                  "tootip": "Comprova que guille no està bloquejat per AllowUsers/DenyUsers o AllowGroups/DenyGroups",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | (grep -q '^denyusers ' && ! sshd -T | grep -q '^denyusers .*\\bguille\\b' || true) && (grep -q '^allowusers ' && sshd -T | grep -q '^allowusers .*\\bguille\\b' || true) && (grep -q '^denygroups ' && ! sshd -T | grep -q '^denygroups .*\\badmins\\b' || true) && (grep -q '^allowgroups ' && sshd -T | grep -q '^allowgroups .*\\badmins\\b' || true)"
                },{
                  "tarea": "Usuari guille té almenys una clau pública autoritzada",
                  "status": "Pending",
                  "tootip": "Comprova que existeix ~/.ssh/authorized_keys i té com a mínim una línia de clau",
                  "extrafield": "None",
                  "command": "test -f ~guille/.ssh/authorized_keys && grep -Eq '^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp)' ~guille/.ssh/authorized_keys"
                },{
                  "tarea": "Permisos correctes a la carpeta SSH de guille",
                  "status": "Pending",
                  "tootip": "Comprova propietari i permisos (700 a .ssh i 600 a authorized_keys)",
                  "extrafield": "None",
                  "command": "test \"$(stat -c '%U:%G %a' ~guille/.ssh 2>/dev/null)\" = \"guille:guille 700\" && test \"$(stat -c '%U:%G %a' ~guille/.ssh/authorized_keys 2>/dev/null)\" = \"guille:guille 600\""
                },{
                  "tarea": "Accés root deshabilitat per SSH",
                  "status": "Pending",
                  "tootip": "Comprova que PermitRootLogin és 'no' o 'prohibit-password'",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^permitrootlogin (no|prohibit-password)$'"
                },{
                  "tarea": "El grup admins només pot entrar per clau",
                  "status": "Pending",
                  "tootip": "Comprova que l'autenticació per contrasenya està desactivada (PasswordAuthentication no)",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^passwordauthentication no$'"
                },{
                  "tarea": "Autenticació per clau pública activa",
                  "status": "Pending",
                  "tootip": "Comprova que PubkeyAuthentication està activat",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^pubkeyauthentication yes$'"
                },{
                  "tarea": "Port SSH configurat a 2222",
                  "status": "Pending",
                  "tootip": "Comprova la configuració efectiva del port a sshd",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^port 2222$'"
                },{
                  "tarea": "Connexió local a SSH (2222) respon",
                  "status": "Pending",
                  "tootip": "Comprova que el servidor SSH respon localment (banner/version)",
                  "extrafield": "None",
                  "command": "timeout 5 bash -lc 'echo | nc -w 3 127.0.0.1 2222' | head -n 1 | grep -Eq '^SSH-'"
                },{
                  "tarea": "Configuració SSH vàlida",
                  "status": "Pending",
                  "tootip": "Comprova que la configuració no té errors (sshd -t)",
                  "extrafield": "None",
                  "command": "sshd -t"
                },{
                  "tarea": "Accés per contrasenya desactivat també per PAM",
                  "status": "Pending",
                  "tootip": "Comprova que UsePAM està activat (recomanat en molts entorns) o explícit segons política",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^usepam (yes|no)$'"
                },{
                  "tarea": "Desactivat ChallengeResponseAuthentication",
                  "status": "Pending",
                  "tootip": "Evita autenticació interactiva tipus keyboard-interactive si no es vol",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^kbdinteractiveauthentication no$|^challengeresponseauthentication no$' || true"
                },{
                  "tarea": "Només protocols segurs (Protocol 2)",
                  "status": "Pending",
                  "tootip": "Assegura que no s'accepta SSHv1 (en sistemes moderns hauria de ser així)",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^protocol 2$' || true"
                },{
                  "tarea": "Usuari guille té shell vàlida",
                  "status": "Pending",
                  "tootip": "Comprova que la shell de guille no és nologin/false",
                  "extrafield": "None",
                  "command": "getent passwd guille | awk -F: '{print $7}' | grep -Evq '(nologin|false)$'"
                },{
                  "tarea": "Sense accés SSH per usuaris del sistema (AllowGroups)",
                  "status": "Pending",
                  "tootip": "Recomanat: restringeix l'accés via AllowGroups (p. ex. admins)",
                  "extrafield": "None",
                  "command": "sshd -T 2>/dev/null | grep -Eq '^allowgroups .*\\badmins\\b' || true"
                },{
                  "tarea": "Firewall permet el port 2222",
                  "status": "Pending",
                  "tootip": "Comprova que el port 2222 no està bloquejat localment (ufw/firewalld/iptables)",
                  "extrafield": "None",
                  "command": "(command -v ufw >/dev/null 2>&1 && ufw status | grep -Eq '2222/tcp\\s+ALLOW') || (command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --list-ports | grep -Eq '\\b2222/tcp\\b') || true"
                },{
                  "tarea": "Túnel 'dev-tunnel' definit",
                  "status": "Pending",
                  "tootip": "Comprova que existeix una entrada Host dev-tunnel a la configuració SSH de guille",
                  "extrafield": "None",
                  "command": "test -f ~guille/.ssh/config && awk 'tolower($1)==\"host\"{h=$2} h==\"dev-tunnel\"{print}' ~guille/.ssh/config | head -n 1 | grep -qi 'dev-tunnel'"
                },{
                  "tarea": "Connexió a la VPN activa",
                  "status": "Pending",
                  "tootip": "Comprova que hi ha una interfície VPN (wg0/tun0) aixecada",
                  "extrafield": "None",
                  "command": "ip link show | grep -Eq '\\b(wg0|tun0|tap0)\\b'"
                }
              ]
            },
            {
  "title": "DNS",
  "id": "DNS",
      "tasks": [
        {
          "tarea": "Servidor DNS instal·lat",
          "status": "Pending",
          "tootip": "Comprova que BIND9 (named) està instal·lat",
          "extrafield": "None",
          "command": "command -v named >/dev/null 2>&1 || dpkg -l | grep -Eq '^ii\\s+bind9\\s' || rpm -qa | grep -qi '^bind'"
        },{
          "tarea": "Servidor DNS actiu",
          "status": "Pending",
          "tootip": "Comprova que el servei bind9/named està en execució",
          "extrafield": "None",
          "command": "systemctl is-active bind9 >/dev/null 2>&1 || systemctl is-active named"
        },{
          "tarea": "Port 53 UDP escoltant",
          "status": "Pending",
          "tootip": "Comprova que hi ha servei DNS escoltant al port UDP 53",
          "extrafield": "None",
          "command": "ss -lun | awk '{print $5}' | grep -Eq '(:|\\.)53$'"
        },{
          "tarea": "Port 53 TCP escoltant",
          "status": "Pending",
          "tootip": "Comprova que hi ha servei DNS escoltant al port TCP 53",
          "extrafield": "None",
          "command": "ss -ltn | awk '{print $4}' | grep -Eq '(:|\\.)53$'"
        },{
          "tarea": "Configuració de BIND vàlida",
          "status": "Pending",
          "tootip": "Valida la configuració global amb named-checkconf",
          "extrafield": "None",
          "command": "named-checkconf"
        },{
          "tarea": "Zona del grup creada",
          "status": "Pending",
          "tootip": "Comprova que la zona %GRUP%.local resol (SOA o A/NS)",
          "extrafield": "None",
          "command": "dig +short SOA %GRUP%.local @127.0.0.1 | grep -q '\\.' || nslookup -type=soa %GRUP%.local 127.0.0.1"
        },{
          "tarea": "Registre NS creat",
          "status": "Pending",
          "tootip": "Comprova que la zona publica registres NS",
          "extrafield": "None",
          "command": "dig +short NS %GRUP%.local @127.0.0.1 | grep -q '\\.' || nslookup -type=ns %GRUP%.local 127.0.0.1"
        },{
          "tarea": "Registre MX creat",
          "status": "Pending",
          "tootip": "Comprova que la zona publica un registre MX",
          "extrafield": "None",
          "command": "dig +short MX %GRUP%.local @127.0.0.1 | grep -Eq '[0-9]+\\s+.+\\.' || nslookup -type=mx %GRUP%.local 127.0.0.1"
        },{
          "tarea": "Registre TXT amb SPF creat",
          "status": "Pending",
          "tootip": "Comprova que existeix un TXT que contingui 'v=spf1'",
          "extrafield": "None",
          "command": "dig +short TXT %GRUP%.local @127.0.0.1 | grep -qi 'v=spf1' || nslookup -type=txt %GRUP%.local 127.0.0.1 | grep -qi 'v=spf1'"
        },{
          "tarea": "Host server creat",
          "status": "Pending",
          "tootip": "Resol server.%GRUP%.local (A/AAAA o CNAME)",
          "extrafield": "None",
          "command": "dig +short server.%GRUP%.local @127.0.0.1 | grep -Eq '([0-9]{1,3}\\.){3}[0-9]{1,3}|:' || nslookup server.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "Host dev creat",
          "status": "Pending",
          "tootip": "Resol dev.%GRUP%.local (A/AAAA o CNAME)",
          "extrafield": "None",
          "command": "dig +short dev.%GRUP%.local @127.0.0.1 | grep -Eq '([0-9]{1,3}\\.){3}[0-9]{1,3}|:' || nslookup dev.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "Host prod creat",
          "status": "Pending",
          "tootip": "Resol prod.%GRUP%.local (A/AAAA o CNAME)",
          "extrafield": "None",
          "command": "dig +short prod.%GRUP%.local @127.0.0.1 | grep -Eq '([0-9]{1,3}\\.){3}[0-9]{1,3}|:' || nslookup prod.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "Host backups creat",
          "status": "Pending",
          "tootip": "Resol backups.%GRUP%.local (A/AAAA o CNAME)",
          "extrafield": "None",
          "command": "dig +short backups.%GRUP%.local @127.0.0.1 | grep -Eq '([0-9]{1,3}\\.){3}[0-9]{1,3}|:' || nslookup backups.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "CNAME mail creat",
          "status": "Pending",
          "tootip": "Comprova que mail.%GRUP%.local resol (habitualment com a CNAME cap al servidor de correu)",
          "extrafield": "None",
          "command": "dig mail.%GRUP%.local @127.0.0.1 +noall +answer | grep -Eq '\\sCNAME\\s|\\sA\\s|\\sAAAA\\s' || nslookup mail.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "CNAME ftp creat",
          "status": "Pending",
          "tootip": "Comprova que ftp.%GRUP%.local resol",
          "extrafield": "None",
          "command": "dig ftp.%GRUP%.local @127.0.0.1 +noall +answer | grep -Eq '\\sCNAME\\s|\\sA\\s|\\sAAAA\\s' || nslookup ftp.%GRUP%.local 127.0.0.1"
        },{
          "tarea": "CNAME www creat",
          "status": "Pending",
          "tootip": "Comprova que www.%GRUP%.local resol",
          "extrafield": "None",
          "command": "dig www.%GRUP%.local @127.0.0.1 +noall +answer | grep -Eq '\\sCNAME\\s|\\sA\\s|\\sAAAA\\s' || nslookup www.%GRUP%.local 127.0.0.1"
        },{
